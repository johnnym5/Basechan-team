rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    // --- APPLICATION COLLECTIONS & RECURSIVE WILDCARDS ---

    match /users/{userId=**} {
      allow read, write: if isAuthenticated();
    }

    match /organizations/{orgId=**} {
      allow read, write: if isAuthenticated();
    }

    match /system_configs/{configId=**} {
      allow read, write: if isAuthenticated();
    }

    match /attendance/{attendanceId=**} {
      allow read, write: if isAuthenticated();
    }

    match /daily_reports/{reportId=**} {
      allow read, write: if isAuthenticated();
    }

    match /daily_debriefs/{debriefId=**} {
      allow read, write: if isAuthenticated();
    }

    match /tasks/{taskId=**} {
      allow read, write: if isAuthenticated();
    }

    match /leave_requests/{leaveId=**} {
      allow read, write: if isAuthenticated();
    }

    match /chats/{chatId=**} {
      allow read, write: if isAuthenticated();
    }

    match /chat_messages/{messageId=**} {
      allow read, write: if isAuthenticated();
    }

    match /announcements/{announcementId=**} {
      allow read, write: if isAuthenticated();
    }

    match /notifications/{notificationId=**} {
      allow read, write: if isAuthenticated();
    }

    match /external_displays/{displayId=**} {
      allow read, write: if isAuthenticated();
    }

    match /journal_entries/{entryId=**} {
      allow read, write: if isAuthenticated();
    }

    match /accounts/{accountId=**} {
      allow read, write: if isAuthenticated();
    }

    match /purchase_orders/{poId=**} {
      allow read, write: if isAuthenticated();
    }

    match /requisitions/{reqId=**} {
      allow read, write: if isAuthenticated();
    }

    match /audit_logs/{logId=**} {
      allow read, write: if isAuthenticated();
    }

    match /idempotency_keys/{keyId=**} {
      allow read, write: if isAuthenticated();
    }

    match /roles/{roleId=**} {
      allow read, write: if isAuthenticated();
    }

    match /accolade_categories/{catId=**} {
      allow read, write: if isAuthenticated();
    }

    match /recognition_categories/{catId=**} {
      allow read, write: if isAuthenticated();
    }

    match /nominations/{nomId=**} {
      allow read, write: if isAuthenticated();
    }

    match /accolade_votes/{voteId=**} {
      allow read, write: if isAuthenticated();
    }

    match /workbooks/{workbookId=**} {
      allow read, write: if isAuthenticated();
    }

    match /library_items/{itemId=**} {
      allow read, write: if isAuthenticated();
    }

    match /feedback/{feedbackId=**} {
      allow read, write: if isAuthenticated();
    }

    match /pulse_checks/{pulseId=**} {
      allow read, write: if isAuthenticated();
    }

    match /webrtc-sessions/{sessionId=**} {
      allow read, write: if isAuthenticated();
    }

    match /acknowledged_alerts/{alertId=**} {
      allow read, write: if isAuthenticated();
    }

    match /rosters/{rosterId=**} {
      allow read, write: if isAuthenticated();
    }

    match /kudos/{kudosId=**} {
      allow read, write: if isAuthenticated();
    }

    match /performance_reviews/{reviewId=**} {
      allow read, write: if isAuthenticated();
    }

    // Allow authenticated access to all remaining paths
    match /{document=**} {
      allow read, write: if isAuthenticated();
    }
  }
}
